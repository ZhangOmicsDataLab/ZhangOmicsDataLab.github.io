---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, links } = project.data;
---
<Base title={title}>
  <article class="detail project-detail">
    <h1>{title}</h1>
    <div class="prose"><Content /></div>
    {links.length > 0 && (
      <dl class="prose">
        {links.map((l) => (<><dt>{l.label}:</dt><dd><a href={l.href}>{l.href}</a></dd></>))}
      </dl>
    )}
  </article>
</Base>
