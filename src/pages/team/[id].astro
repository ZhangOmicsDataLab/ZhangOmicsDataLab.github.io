---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  return (await getCollection('team')).map((member) => ({ params: { id: member.id }, props: { member } }));
}

const { member } = Astro.props;
const { Content } = await render(member);
const { name, heading, photo, links, interests } = member.data;
const grouped = Object.entries(Object.groupBy(links, (l) => l.label));
---
<Base title={name}>
  <article class="detail">
    <Image class="avatar-lg" src={photo} alt={name} width={400} height={400} />
    <h1>{heading ?? name}</h1>
    <div class="prose"><Content /></div>
    <dl class="prose">
      {grouped.map(([label, items]) => (
        <>
          <dt>{label}:</dt>
          <dd>
            {items!.map((l, i) => (<>{i > 0 && '; '}<a href={l.href}>{l.text}</a></>))}
          </dd>
        </>
      ))}
      {interests && (<><dt>Interests:</dt><dd>{interests}</dd></>)}
    </dl>
  </article>
</Base>
