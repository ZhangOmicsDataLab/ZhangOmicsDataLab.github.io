---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { site } from '../data/site';

const tools = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Tools and Publications">
  <section class="hero">
    <h1>Tools and Publications</h1>
    <p class="lead">Explore our latest innovative tools and publications.</p>
  </section>
  <section class="card-grid">
    <Card title="Publications" href={site.scholar} cta="Publications">Discover our Publications.</Card>
    {tools.map((t) => (
      <Card title={t.data.title} href={`/projects/${t.id}.html`} cta="More info">{t.data.summary}</Card>
    ))}
  </section>
</Base>
